          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "value": "test.jpg",
                  "type": "file",
                  "description": "Файл изображения"
                },
                {
                  "key": "description",
                  "value": "Test photo description",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/photos/upload",
              "host": ["{{baseUrl}}"],
              "path": ["api", "photos", "upload"]
