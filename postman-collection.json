    {
      "name": "6. Управление лицензиями",
      "item": [
        {
          "name": "POST - Создать лицензию (ADMIN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.code) {",
                  "    pm.environment.set(\"licenseCode\", jsonData.code);",
                  "    pm.environment.set(\"licenseId\", jsonData.licenseId ? jsonData.licenseId.toString() : \"\");",
                  "    console.log(\"License code saved:\", jsonData.code);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"productId\": {{productId}},\n    \"typeId\": {{licenseTypeId}},\n    \"ownerId\": 1,\n    \"deviceCount\": 3,\n    \"description\": \"Тестовая лицензия\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/licenses/create",
              "host": ["{{baseUrl}}"],
              "path": ["licenses", "create"]
            }
          },
          "response": []
        },
        {
          "name": "POST - Активировать лицензию на устройстве",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.ticket && jsonData.signature) {",
                  "    console.log(\"License activated successfully\");",
                  "    pm.environment.set(\"deviceMac\", pm.request.body.raw ? JSON.parse(pm.request.body.raw).deviceMac : pm.environment.get(\"deviceMac\"));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"activationKey\": \"{{licenseCode}}\",\n    \"deviceMac\": \"{{deviceMac}}\",\n    \"deviceName\": \"Мой компьютер\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/licenses/activate",
              "host": ["{{baseUrl}}"],
              "path": ["licenses", "activate"]
            }
          },
          "response": []
        },
        {
          "name": "POST - Проверить лицензию",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"deviceMac\": \"{{deviceMac}}\",\n    \"productId\": {{productId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/licenses/check",
              "host": ["{{baseUrl}}"],
              "path": ["licenses", "check"]
            }
          },
          "response": []
        },
        {
          "name": "POST - Продлить лицензию",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"activationKey\": \"{{licenseCode}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/licenses/renew",
              "host": ["{{baseUrl}}"],
              "path": ["licenses", "renew"]
            }
          },
          "response": []
        },
        {
          "name": "GET - Получить тикет по коду лицензии",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"macAddress\": \"{{deviceMac}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/licenses/{{licenseCode}}/ticket",
              "host": ["{{baseUrl}}"],
