    {
      "name": "2. Управление фото",
      "item": [
        {
          "name": "POST - Загрузить фото",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.photoId) {",
                  "    pm.environment.set(\"photoId\", jsonData.photoId.toString());",
                  "    console.log(\"Photo ID saved:\", jsonData.photoId);",
